FROM node:26-alpine3.24 AS build

WORKDIR /app

ARG VITE_API_BASE_URL=/api
ARG VITE_THUMBNAIL_REFRESH_INTERVAL_MS=1000
ARG VITE_DASHBOARD_REFRESH_INTERVAL_MS=5000
ARG VITE_ADMIN_PRESENCE_REFRESH_INTERVAL_MS=30000
ARG VITE_MAINTENANCE_REFRESH_INTERVAL_MS=5000
ARG VITE_ROUTERS_REFRESH_INTERVAL_MS=5000
ARG VITE_STATISTICS_REFRESH_INTERVAL_MS=30000

COPY apps/cmnc-web/package*.json ./
RUN npm ci

COPY apps/cmnc-web ./
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_THUMBNAIL_REFRESH_INTERVAL_MS=${VITE_THUMBNAIL_REFRESH_INTERVAL_MS}
ENV VITE_DASHBOARD_REFRESH_INTERVAL_MS=${VITE_DASHBOARD_REFRESH_INTERVAL_MS}
ENV VITE_ADMIN_PRESENCE_REFRESH_INTERVAL_MS=${VITE_ADMIN_PRESENCE_REFRESH_INTERVAL_MS}
ENV VITE_MAINTENANCE_REFRESH_INTERVAL_MS=${VITE_MAINTENANCE_REFRESH_INTERVAL_MS}
ENV VITE_ROUTERS_REFRESH_INTERVAL_MS=${VITE_ROUTERS_REFRESH_INTERVAL_MS}
ENV VITE_STATISTICS_REFRESH_INTERVAL_MS=${VITE_STATISTICS_REFRESH_INTERVAL_MS}
RUN npm run build


FROM nginx:1.31.8-alpine3.24-slim

COPY apps/cmnc-web/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
