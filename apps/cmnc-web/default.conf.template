# Keep health probes out of access logs while retaining other requests.
map "$request_method:$uri" $cmnc_log_request {
    default 1;
    "GET:/health" 0;
}

server {
    listen ${CMNC_WEB_PORT};
    server_name _;

    access_log /var/log/nginx/access.log main if=$cmnc_log_request;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:${CMNC_API_GATEWAY_PORT}/api/;
        proxy_http_version 1.1;
        proxy_read_timeout 130s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # IP authentication must not accept a caller-supplied address chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://127.0.0.1:${CMNC_API_GATEWAY_PORT}/health;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}